# --- Desenvolvimento ---
# O Vite repassa /api para este endereço (Java local ou mock). Padrão: http://localhost:8080
VITE_PROXY_TARGET=http://localhost:8080

# --- Normalmente NÃO preencher ---
# Só use se o front chamar o Java direto (exige CORS liberado no Java). Deixe vazio para usar o repasse.
VITE_API_URL=
# Prefixo das rotas do Java (padrão: /api, o mesmo da API publicada)
VITE_API_PREFIX=/api
# E-mail que recebe o formulário de Contato (abre o app de e-mail da pessoa)
VITE_EMAIL_CONTATO=
